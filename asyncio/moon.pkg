import {
  "LilaLola67/moonmcap" @mcap,
  "moonbitlang/async",
  "moonbitlang/async/js_async",
  "moonbitlang/core/buffer",
  "moonbitlang/core/encoding/utf8",
}

options(
  targets: {
    "node.mbt": [ "js" ],
    "http.mbt": [ "js" ],
    "async_test.mbt": [ "js" ],
    "unsupported.mbt": [ "not", "js" ],
  },
)
