    @moonmcap.protobuf_decoder(descriptor, options={
      ..@moonmcap.protobuf_json_options(),
      emit_defaults: true,
    }).decode("test.Defaults", @moonmcap.decode_hex("")),
    @json.parse("{\"items\": []}"),
  )
  assert_eq(
    @moonmcap.protobuf_decoder(
      descriptor,
      options=@moonmcap.protobuf_json_options(),
    ).decode("test.Defaults", @moonmcap.decode_hex("082a")),
    @json.parse("{\"n\": 42}"),
  )
  assert_eq(
    @moonmcap.protobuf_decoder(descriptor, options={
      ..@moonmcap.protobuf_json_options(),
      emit_defaults: true,
    }).decode("test.Defaults", @moonmcap.decode_hex("082a")),
    @json.parse("{\"n\": 42, \"items\": []}"),
  )
  assert_eq(
    @moonmcap.protobuf_decoder(
      descriptor,
      options=@moonmcap.protobuf_json_options(),
    ).decode(
      "google.protobuf.Any",
      @moonmcap.decode_hex(
        "0a21747970652e676f6f676c65617069732e636f6d2f746573742e50726573656e636512020807",
      ),
    ),
    @json.parse("{\"@type\": \"type.googleapis.com/test.Presence\", \"n\": 7}"),
  )
  assert_eq(
    @moonmcap.protobuf_decoder(descriptor, options={
      ..@moonmcap.protobuf_json_options(),
      emit_defaults: true,
    }).decode(
      "google.protobuf.Any",
      @moonmcap.decode_hex(
        "0a21747970652e676f6f676c65617069732e636f6d2f746573742e50726573656e636512020807",
      ),
    ),
    @json.parse(
      "{\"@type\": \"type.googleapis.com/test.Presence\", \"n\": 7, \"items\": []}",
    ),
  )
  assert_eq(
    @moonmcap.protobuf_decoder(
      descriptor,
      options=@moonmcap.protobuf_json_options(),
    ).decode("test.MappedTime", @moonmcap.decode_hex("0a070a036b65791200")),
    @json.parse("{\"times\": {\"key\": \"1970-01-01T00:00:00Z\"}}"),
  )
  assert_eq(
    @moonmcap.protobuf_decoder(descriptor, options={
      ..@moonmcap.protobuf_json_options(),
      emit_defaults: true,
    }).decode("test.MappedTime", @moonmcap.decode_hex("0a070a036b65791200")),
    @json.parse("{\"times\": {\"key\": \"1970-01-01T00:00:00Z\"}}"),
  )
  assert_eq(
    @moonmcap.protobuf_decoder(
      descriptor,
      options=@moonmcap.protobuf_json_options(),
    ).decode("test.Presence", @moonmcap.decode_hex("08001200")),
