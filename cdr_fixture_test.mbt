test "XCDR1 scalar alignment arrays and nested ROS messages match independent serializer" {
  assert_eq(
    @moonmcap.cdr_decoder(
      "demo/msg/Sample",
      @moonmcap.decode_hex(
        "",
      ),
    ).decode(
      @moonmcap.decode_hex(
        "",
      ),
    ),
    @json.parse(
      "{\"enabled\": true, \"small\": -128, \"octet\": 127, \"character\": 65, \"signed16\": -32768, \"unsigned16\": 65535, \"signed32\": -2147483648, \"unsigned32\": 4294967295, \"signed64\": -9223372036854775808, \"unsigned64\": 18446744073709551615, \"scalar32\": 1.25, \"scalar64\": -2.5, \"label\": \"\\u6708\\u7403\", \"bounded_text\": \"bounded\", \"vector\": [1.0, 2.5, -4.0], \"data\": [0, 255, 3], \"samples\": [-1, 32767], \"header\": {\"stamp\": {\"sec\": -7, \"nanosec\": 999999999}, \"frame_id\": \"frame\"}, \"pose\": {\"position\": {\"x\": 1.0, \"y\": 2.0, \"z\": 3.0}, \"orientation\": {\"x\": 0.0, \"y\": 0.0, \"z\": 0.0, \"w\": 1.0}}}",
    ),
  )
  assert_eq(
    @moonmcap.cdr_decoder(
      "demo/msg/Sample",
      @moonmcap.decode_hex(
        "",
      ),
    ).decode(
      @moonmcap.decode_hex(
        "",
      ),
    ),
    @json.parse(
      "{\"enabled\": true, \"small\": -128, \"octet\": 127, \"character\": 65, \"signed16\": -32768, \"unsigned16\": 65535, \"signed32\": -2147483648, \"unsigned32\": 4294967295, \"signed64\": -9223372036854775808, \"unsigned64\": 18446744073709551615, \"scalar32\": 1.25, \"scalar64\": -2.5, \"label\": \"\\u6708\\u7403\", \"bounded_text\": \"bounded\", \"vector\": [1.0, 2.5, -4.0], \"data\": [0, 255, 3], \"samples\": [-1, 32767], \"header\": {\"stamp\": {\"sec\": -7, \"nanosec\": 999999999}, \"frame_id\": \"frame\"}, \"pose\": {\"position\": {\"x\": 1.0, \"y\": 2.0, \"z\": 3.0}, \"orientation\": {\"x\": 0.0, \"y\": 0.0, \"z\": 0.0, \"w\": 1.0}}}",
    ),
  )
  assert_eq(
    @moonmcap.cdr_decoder("std_msgs/msg/Empty", @moonmcap.decode_hex("")).decode(
      @moonmcap.decode_hex("0001000000"),
    ),
    @json.parse("{}"),
  )
}
