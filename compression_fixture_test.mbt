// Generated reference frames; not handwritten implementation source.

///|
test "reference LZ4 linked=False checksum=False" {
  let bytes = @moonmcap.decode_hex("")
  let expected = Bytes::makei(180000, fn(i) { b"abcdef"[i % 6] })
  assert_eq(@moonmcap.decompress_payload(bytes, "lz4", 180000UL), expected)
}

///|
test "reference LZ4 linked=False checksum=True" {
  let bytes = @moonmcap.decode_hex("")
  let expected = Bytes::makei(180000, fn(i) { b"abcdef"[i % 6] })
  assert_eq(@moonmcap.decompress_payload(bytes, "lz4", 180000UL), expected)
}

