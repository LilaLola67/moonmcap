///|
test "reference Zstd level=1 known_size=False checksum=False" {
  let bytes = @moonmcap.decode_hex("28b52ffd0040740000306162636465660100f7ffc94b114d0000086301001c3f1d0801")
  let expected = Bytes::makei(180000, fn(i) { b"abcdef"[i % 6] })
  assert_eq(@moonmcap.decompress_payload(bytes, "zstd", 180000UL), expected)
}

///|
test "reference Zstd level=1 known_size=True checksum=True" {
  let bytes = @moonmcap.decode_hex("28b52ffda420bf0200740000306162636465660100f7ffc94b114d0000086301001c3f1d08017a71f26c")
  let expected = Bytes::makei(180000, fn(i) { b"abcdef"[i % 6] })
  assert_eq(@moonmcap.decompress_payload(bytes, "zstd", 180000UL), expected)
}

