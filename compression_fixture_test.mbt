  let bytes = @moonmcap.decode_hex("")
  let expected = Bytes::makei(180000, fn(i) { b"abcdef"[i % 6] })
  assert_eq(@moonmcap.decompress_payload(bytes, "lz4", 180000UL), expected)
}

///|
test "reference LZ4 linked=True checksum=True" {
  let bytes = @moonmcap.decode_hex("")
  let expected = Bytes::makei(180000, fn(i) { b"abcdef"[i % 6] })
  assert_eq(@moonmcap.decompress_payload(bytes, "lz4", 180000UL), expected)
