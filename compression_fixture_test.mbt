///|
test "reference Zstd block kind 0" {
  let bytes = @moonmcap.decode_hex("28b52ffda00c000000610000726177206c69746572616c73")
  assert_eq(@moonmcap.decompress_payload(bytes, "zstd", 12UL), b"raw literals")
}

///|
test "reference Zstd block kind 1" {
  let bytes = @moonmcap.decode_hex("28b52ffda0f4010000a30f0052")
  assert_eq(@moonmcap.decompress_payload(bytes, "zstd", 500UL), Bytes::make(500, b'R'))
}
